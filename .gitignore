# Unreal Editor for Fortnite (UEFN) / UE5 Ignores

# Cache files for the editor
DerivedDataCache/
.lore/

# Compiled temp files and intermediate assets
Intermediate/
Plugins/**/Intermediate/

# Local configurations, logs, and auto-saves generated by the Editor
Saved/

# Compiled Binaries
Binaries/
Plugins/**/Binaries/

# IDE and Project Files (VS, VS Code, Rider)
.vs/
.vscode/
.idea/
*.sln
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
.vsconfig

# Local IDE Workspace Paths
*.code-workspace


ZombieDefense.code-workspace
